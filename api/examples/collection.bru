meta {
  name: Evolute companion API (unofficial)
}

docs {
  Unofficial collection for https://app.evassist.ru
  Auth header: access-token (not Bearer)
  Shared vars live in this file. Duplicate as request .bru files if you need per-request seq.
}

auth {
  mode: none
}

vars {
  baseUrl: https://app.evassist.ru
  accessToken: 
  refreshToken: 
  carId: aaaaaaaaaaaaaaaaaaaaaaaa
  imei: 000000000000000
  travelId: 84
  startTime: 1700000000
  phone: 00000000000
  phoneCountry: XX
  otp: 000000
}

headers {
  accept: application/json
  content-type: application/json
  cache-control: no-cache
  x-device: android
  x-app: mobile
  x-app-version: 5.1.22 (740)
}

meta {
  name: refresh tokens
  type: http
  seq: 4
}
post {
  url: {{baseUrl}}/id-service/auth/refresh-token
}
headers {
  accept: application/json
  content-type: application/json
  cache-control: no-cache
  x-device: android
  x-app: mobile
  x-app-version: 5.1.22 (740)
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

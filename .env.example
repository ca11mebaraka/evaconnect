# Copy to .env (never commit). Used by docker compose and the poller.
POSTGRES_PASSWORD=
GRAFANA_DB_PASSWORD=

EVOLUTE_ACCESS_TOKEN=
EVOLUTE_REFRESH_TOKEN=
EVOLUTE_CAR_ID=
EVOLUTE_CREDENTIALS=/data/credentials.json

# Optional poller overrides (telemetry must stay >= 5).
# POLL_TELEMETRY_INTERVAL_S=30
# POLL_TRIPS_INTERVAL_S=900
# POLL_TRIP_LIMIT=20
# DATABASE_URL=postgresql://evaconnect:…@db:5432/evaconnect
